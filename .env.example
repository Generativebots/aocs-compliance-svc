# =============================================================================
# aocs-compliance-svc — Environment Variables
# Copy this file to .env and fill in all required values.
# NEVER commit .env — only .env.example is tracked.
# =============================================================================

# ── Supabase (REQUIRED) ───────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Database (REQUIRED) ───────────────────────────────────────────────────────
# Uses compliance schema: search_path=compliance,public
DATABASE_URL=postgresql://postgres.yourprojectref:password@host:5432/postgres?search_path=compliance,public&sslmode=require
POSTGRES_HOST=aws-0-us-east-1.pooler.supabase.com
POSTGRES_PORT=6543
POSTGRES_DB=postgres
POSTGRES_USER=postgres.yourprojectref
# Schema: compliance (not public — compliance tables live under compliance schema)
POSTGRES_SCHEMA=compliance

# ── Ring 0 — aocs-system-svc (REQUIRED) ──────────────────────────────────────
# Used for tenant validation and billing entitlement checks
INTERNAL_API_URL=http://aocs-platform:8082

# ── Ring 1 — ocx-core-svc (REQUIRED AT RUNTIME) ──────────────────────────────
# Compliance reads agent executions, HITL decisions, enforcement actions from Ring 1.
# Compliance will start but report handlers will 503 if this is not set.
CORE_INTERNAL_API_URL=http://aocs-gate:8083
HUB_INTERNAL_API_URL=http://aocs-hub:8085

# ── Security ──────────────────────────────────────────────────────────────────
SERVICE_JWT_SECRET=your-service-jwt-secret
PLATFORM_MASTER_KEY=your-aes-256-master-key-hex

# ── GCP Pub/Sub (for ZKP batch jobs and ledger consumer) ─────────────────────
GCP_PROJECT_ID=your-gcp-project
PUBSUB_EMULATOR_HOST=       # leave empty for production; set for local dev
LEDGER_PUBSUB_TOPIC=aocs-compliance-ledger

# ── Application ───────────────────────────────────────────────────────────────
OCX_ENV=development
PORT=8089
SERVICE_NAME=aocs-compliance
LOG_LEVEL=info

# ── Feature control ───────────────────────────────────────────────────────────
# Set to true to enable ZKP proof generation (compute-heavy, paid feature)
ZKP_ENABLED=true
# Set to true to enable DLP scanning (paid feature)
DLP_ENABLED=true
